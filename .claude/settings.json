{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gradlew *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(Test-Path *)",
      "Bash(Get-ChildItem *)",
      "Read(**/*.java)",
      "Read(**/*.yml)",
      "Read(**/*.yaml)",
      "Read(**/*.gradle)",
      "Read(**/*.properties)",
      "Read(**/*.xml)",
      "Read(**/*.md)",
      "Read(**/*.json)",
      "Read(*.gradle)",
      "Read(*.properties)",
      "Read(gradle.properties)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(Remove-Item *)",
      "Bash(Move-Item *)",
      "Write(**/*.java)",
      "Write(**/*.yml)",
      "Write(**/*.yaml)",
      "Write(**/*.properties)",
      "Write(**/*.xml)",
      "Write(*.gradle)",
      "Write(*.properties)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/secrets/**)",
      "Read(**/credentials*)",
      "Bash(git push --force *)",
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(gradlew clean)",
      "Bash(Docker-*)"
    ],
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable"
  },
  "includeCoAuthoredBy": false,
  "cleanupPeriodDays": 14,
  "worktree": {
    "symlinkDirectories": ["build", ".gradle"]
  }
}
