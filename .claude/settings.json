{
  "permissions": {
    "read": [
      "**/*.java",
      "**/*.yml",
      "**/*.yaml",
      "**/*.gradle",
      "**/*.properties",
      "**/*.xml",
      "**/*.md",
      "build.gradle",
      "settings.gradle",
      "gradle.properties"
    ],
    "write": [
      "src/**/*.java",
      "**/*.yml",
      "**/*.yaml",
      "**/*.properties",
      "**/*.xml",
      "**/*.md",
      "build.gradle",
      "settings.gradle",
      "gradle.properties"
    ],
    "execute": [
      "gradlew",
      "git",
      "docker"
    ],
    "network": [
      "localhost:8080",
      "localhost:3306",
      "localhost:8848",
      "api.github.com"
    ]
  },
  "git": {
    "autoCommit": false,
    "requireTests": false,
    "commitMessageTemplate": "type(scope): description"
  },
  "java": {
    "buildTool": "gradle",
    "testCommand": "gradlew test",
    "compileCommand": "gradlew compileJava",
    "packageCommand": "gradlew build"
  }
}
